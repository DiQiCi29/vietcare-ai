# ==============================================================================
# VIETCARE AI - CẤU HÌNH BIẾN MÔI TRƯỜNG (.env)
# ==============================================================================

# 1. Ứng dụng chung
PROJECT_NAME="VietCare AI - Quản lý bảo hành Viettronimex Đà Nẵng"
VERSION="1.0.0"
DEBUG=True
API_V1_STR="/api/v1"
SECRET_KEY="vietcare-super-secret-key-change-in-production-12345678"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# 2. Cơ sở dữ liệu (Mặc định SQLite dev, hoặc PostgreSQL: postgresql://user:pass@localhost:5432/vietcare_db)
DATABASE_URL="sqlite:///./vietcare.db"

# 3. Google Gemini AI API (Dành cho RAG Chatbot)
GEMINI_API_KEY="your-gemini-api-key-here"
GEMINI_MODEL="gemini-2.5-flash"

# 4. Gửi Email thông báo (TB-01) - Hỗ trợ Gmail SMTP hoặc Resend
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER="your-email@gmail.com"
SMTP_PASSWORD="your-app-password"
EMAILS_FROM_EMAIL="baohanh@vietro.com.vn"
EMAILS_FROM_NAME="Viettronimex Bảo Hành"

# 5. Lưu trữ tệp tin (Ảnh / Video)
UPLOAD_DIR="./uploads"
MAX_UPLOAD_SIZE_MB=25
